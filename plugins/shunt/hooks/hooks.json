{
  "description": "Deny whole-file reads of large text files (default > 350 lines) and unbounded repo-wide content searches, so both are delegated or bounded instead of entering the main context. Targeted reads (offset/limit, sed -n, head -n), piped commands, and files-only/counted/bounded/scoped searches pass. SHUNT_MIN_LINES overrides the read threshold; SHUNT_DISABLE=1 turns both gates off.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-read.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-read.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-search.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-search.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
