#!/usr/bin/env sh

if ! bun run check:plugins; then
  echo
  echo "Plugin or marketplace manifest validation failed."
  echo "Fix the reported manifest issues before committing."
  exit 1
fi

if ! bun run check:portability; then
  echo
  echo "Agent Plugins 1.0.0 conformance check failed."
  echo "A client would not load the plugin as committed."
  exit 1
fi

if ! bun run check:context; then
  echo
  echo "Injected context commands violate CLAUDE.md rules (static analysis / fallback)."
  echo "Fix the reported lines before committing."
  exit 1
fi

if ! bun run check:run-metadata; then
  echo
  echo "Samuel run metadata coverage check failed."
  echo "Fix the reported coverage or exclusion errors before committing."
  exit 1
fi
